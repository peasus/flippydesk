{
  // Static site served by Cloudflare Workers static assets. No build step.
  "name": "flippydesk",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  // Serve the site on both the bare domain and www.
  "routes": [
    { "pattern": "flippydesk.com", "custom_domain": true },
    { "pattern": "www.flippydesk.com", "custom_domain": true }
  ]
}
